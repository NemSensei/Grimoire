# Tout est optionnel — l'app fonctionne sans configuration.
#
# SESSION_SECRET : par défaut, un secret est généré automatiquement et persisté dans
# data/.session-secret au premier démarrage. À ne définir explicitement que si vous voulez
# contrôler/faire tourner ce secret vous-même (>= 32 caractères).
# SESSION_SECRET=

# CONTENT_DIR : dossier des fiches Markdown (défaut : ./content)
# CONTENT_DIR=./content

# DB_PATH : chemin de la base SQLite (défaut : ./data/grimoire.db)
# DB_PATH=./data/grimoire.db
